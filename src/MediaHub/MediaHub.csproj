<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>MediaHub</AssemblyName>
    <RootNamespace>MediaHub</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MediaHub.ico</ApplicationIcon>
    <WinFspAssemblyPath Condition="'$(WinFspAssemblyPath)' == ''">$(MSBuildProgramFiles32)\WinFsp\bin\winfsp-msil.dll</WinFspAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <Reference Include="winfsp-msil">
      <HintPath>$(WinFspAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckWinFspReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(WinFspAssemblyPath)')" Text="WinFsp .NET assembly not found: $(WinFspAssemblyPath). Install WinFsp with Developer files, or pass -p:WinFspAssemblyPath=path/to/winfsp-msil.dll." />
  </Target>
</Project>
